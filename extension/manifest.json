{
  "manifest_version": 3,
  "name": "ALO - Adaptive Latency Optimization",
  "version": "0.1.0",
  "description": "Applies safe page-load optimizations to sites you open and reports real load times to your local ALO dashboard.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ALO" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost:8000/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost:8000/*"],
      "js": ["defer_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
